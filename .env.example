# Tavily API密钥 - 用于网络搜索
TAVILY_API_KEY=your_tavily_api_key_here

# OpenAI API密钥 - 用于多模态和文本模型
OPENAI_API_KEY=your_openai_api_key_here

# 阿里云OSS配置
ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id_here
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret_here
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=your_bucket_name_here

# ===== 国产大模型配置（二选一）=====

# 方案A：通义千问 Qwen（推荐，与OSS同一生态）
# 获取密钥：https://help.aliyun.com/zh/dashscope/
QWEN_API_KEY=your_dashscope_api_key_here
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
MULTIMODAL_MODEL=qwen-vl-max
TEXT_MODEL=qwen2.5-72b-instruct
# 文生图模型：qwen-image-2.1-turbo 或 wanx 系列模型
WANX_MODEL=qwen-image-2.1-turbo

# 方案B：DeepSeek（性价比高）
# 获取密钥：https://platform.deepseek.com/
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_API_BASE=https://api.deepseek.com
# MULTIMODAL_MODEL=deepseek-vl
# TEXT_MODEL=deepseek-chat

# ===== 以下通用配置 =====
# API密钥统一使用字段名，settings.py会自动识别
# 实际使用时取消方案A或方案B的注释即可

# 其他配置
MAX_TOKENS=4000
MODEL_ENABLE_THINKING=false
MAX_CONTEXT_MESSAGES=12
MAX_CONTEXT_CHARS=12000
MAX_TOOL_RESULT_CHARS=8000
TEMPERATURE=0.7
